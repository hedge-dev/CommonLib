{
    "version": 8,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },

    "configurePresets":
    [
        {
            "name": "Default",
            
            "binaryDir": "${sourceDir}/bin/${presetName}",

            "hidden": true
        },

        {
            "name": "x86",

            "cacheVariables":
            {
                "CMAKE_SYSTEM_PROCESSOR": "X86"
            },

            "hidden": true
        },
        {
            "name": "x64",

            "cacheVariables":
            {
                "CMAKE_SYSTEM_PROCESSOR": "AMD64"
            },

            "hidden": true
        },
        
        {
            "name": "Windows",
            "inherits": "Default",

            "condition": { "lhs": "${hostSystemName}", "type": "equals", "rhs": "Windows" },

            "hidden": true
        },

        {
            "name":     "Windows-MSVC",
            "inherits": "Windows",

            "cacheVariables":
            {
                "CMAKE_TOOLCHAIN_FILE": "toolchains/WindowsToolchain/Windows.MSVC.toolchain.cmake",
                "CMAKE_VS_VERSION_PRERELEASE": "ON",
                "CMAKE_VS_VERSION_RANGE": "[17.0,19.0)",
                "CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION_MAXIMUM": "10.0.26100.0"
            },

            "hidden": true
        },

        {
            "name":     "Windows-MSVC-Ninja",
            "inherits": "Windows-MSVC",

            "generator": "Ninja Multi-Config",

            "hidden": true
        },
        {
            "name":     "Windows-MSVC-Ninja-x86",
            "inherits": ["Windows-MSVC-Ninja", "x86"]
        },
        {
            "name":     "Windows-MSVC-Ninja-x64",
            "inherits": ["Windows-MSVC-Ninja", "x64"]
        },

        {
            "name":     "Windows-MSVC-VS18",
            "inherits": "Windows-MSVC",

            "generator": "Visual Studio 18 2026",

            "hidden": true
        },
        {
            "name":     "Windows-MSVC-VS18-x86",
            "inherits": ["Windows-MSVC-VS18", "x86"],

            "architecture": "Win32"
        },
        {
            "name":     "Windows-MSVC-VS18-x64",
            "inherits": ["Windows-MSVC-VS18", "x64"],

            "architecture": "x64"
        },

        {
            "name":     "Windows-MSVC-VS17",
            "inherits": "Windows-MSVC",

            "generator": "Visual Studio 17 2022",

            "hidden": true
        },
        {
            "name":     "Windows-MSVC-VS17-x86",
            "inherits": ["Windows-MSVC-VS17", "x86"],

            "architecture": "Win32"
        },
        {
            "name":     "Windows-MSVC-VS17-x64",
            "inherits": ["Windows-MSVC-VS17", "x64"],

            "architecture": "x64"
        }
    ],
    
    "buildPresets":
    [
        {
            "name":            "Windows-MSVC-Ninja-x86",
            "configurePreset": "Windows-MSVC-Ninja-x86"
        },
        {
            "name":            "Windows-MSVC-Ninja-x64",
            "configurePreset": "Windows-MSVC-Ninja-x64"
        },

        {
            "name":            "Windows-MSVC-VS18-x86",
            "configurePreset": "Windows-MSVC-VS18-x86"
        },
        {
            "name":            "Windows-MSVC-VS18-x64",
            "configurePreset": "Windows-MSVC-VS18-x64"
        },

        {
            "name":            "Windows-MSVC-VS17-x86",
            "configurePreset": "Windows-MSVC-VS17-x86"
        },
        {
            "name":            "Windows-MSVC-VS17-x64",
            "configurePreset": "Windows-MSVC-VS17-x64"
        }
    ]
}
